<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/network_call_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:showIn="@layout/activity_peekniko"
    tools:theme="@style/Theme.Peekniko">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <peekniko.ui.views.Chip
                android:id="@+id/method_chip"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="GET" />

            <TextView
                android:id="@+id/method_and_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="/v1/items/42" />
        </LinearLayout>

        <TextView
            android:id="@+id/call_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            tools:text="2026-10-24 10:31:08.513 · 128 ms · Payload 230 B" />

        <TextView
            android:id="@+id/call_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/peekniko_error"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp">

        <peekniko.ui.views.Chip
            android:id="@+id/response_status"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            tools:text="200"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/call_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone" />

    </FrameLayout>

</LinearLayout>
