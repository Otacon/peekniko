<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/responseProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:indeterminate="true"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/responseEmptyScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/peekniko_empty_body"
        tools:visibility="visible"/>

    <ScrollView
        android:id="@+id/responseScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/responseBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Peekniko.HeaderSectionContent"
            tools:text="{ 'Key': 'value' }"/>
    </ScrollView>

</FrameLayout>
