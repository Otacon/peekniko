<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/requestProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:indeterminate="true"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/requestEmptyScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/peekniko_empty_body"
        tools:visibility="visible"/>

    <ScrollView
        android:id="@+id/requestScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/requestBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Peekniko.HeaderSectionContent"
                tools:text="{ 'Key': 'value' }"/>

            <ImageView
                android:id="@+id/requestImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/peekniko_body_image"
                android:visibility="gone"/>
        </FrameLayout>
    </ScrollView>

</FrameLayout>
