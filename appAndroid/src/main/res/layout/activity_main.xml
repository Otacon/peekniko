<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/sample_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/local_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/use_local_server" />

        <Button
            android:id="@+id/open_peekniko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_peekniko" />

        <Button
            android:id="@+id/run_okhttp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_okhttp" />

        <Button
            android:id="@+id/run_ktor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/run_ktor" />
    </LinearLayout>
</LinearLayout>
